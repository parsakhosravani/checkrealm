{
  "name": "checkrealm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "checkrealm — check whether a domain/URL realm is reachable and healthy.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @checkrealm/server",
    "dev:client": "npm run dev -w @checkrealm/client",
    "build": "npm run build -w @checkrealm/server && npm run build -w @checkrealm/client",
    "start": "npm run start -w @checkrealm/server",
    "lint": "eslint .",
    "test": "npm run test -w @checkrealm/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  }
}
